@page
@model wt_lab12_12auth_validation_kleshchenok.Pages.RegisterModel
@{
    ViewData["Title"] = "Регистрация";
    ViewData["Active"] = "register";
}

<div class="row justify-content-center mt-5 pt-3">
    <div class="col-12 col-md-8 col-lg-5 col-xl-4">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-md-5">

                <partial name="_AuthTabs" />

                <div class="text-center mb-4">
                    <div class="display-5">📝</div>
                    <h1 class="h3 mt-2 mb-1">Регистрация</h1>
                    <p class="text-muted mb-0">Нет аккаунта? Заполните форму — данные сохранятся в базе</p>
                </div>

                <form method="post" novalidate>
                    <div class="mb-3">
                        <label asp-for="Login" class="form-label"></label>
                        <input asp-for="Login" class="form-control" placeholder="Придумайте логин" autocomplete="username" />
                        <div class="form-text">Латинские буквы, цифры и символы _ . -</div>
                        <span asp-validation-for="Login" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Не менее 4 символов" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Повторите пароль" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2">Зарегистрироваться</button>
                </form>

                <hr class="my-4" />

                <p class="text-center text-muted mb-2">Уже есть аккаунт?</p>
                <a asp-page="/Login" class="btn btn-outline-primary w-100 py-2">Войти</a>
            </div>
        </div>
    </div>
</div>
