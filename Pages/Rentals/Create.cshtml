@page
@model wt_lab12_12auth_validation_kleshchenok.Pages.Rentals.CreateModel
@{
    ViewData["Title"] = "Оформление аренды";
}

<div class="container py-4">
    <div class="card shadow-sm rounded-4">
        <div class="card-body">
            <h2 class="mb-4">📝 Оформление аренды</h2>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="RentalRequest.CarId" class="form-label">Автомобиль</label>
                    <select asp-for="RentalRequest.CarId" class="form-select" asp-items="Model.AvailableCars">
                        <option value="">— выберите автомобиль —</option>
                    </select>
                    <span asp-validation-for="RentalRequest.CarId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="RentalRequest.CustomerId" class="form-label">Клиент</label>
                    <select asp-for="RentalRequest.CustomerId" class="form-select" asp-items="Model.Customers">
                        <option value="">— выберите клиента —</option>
                    </select>
                    <span asp-validation-for="RentalRequest.CustomerId" class="text-danger"></span>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="RentalRequest.StartDate" class="form-label"></label>
                        <input asp-for="RentalRequest.StartDate" type="date" class="form-control" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="RentalRequest.EndDate" class="form-label"></label>
                        <input asp-for="RentalRequest.EndDate" type="date" class="form-control" />
                        <span asp-validation-for="RentalRequest.EndDate" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">💾 Оформить</button>
                    <a asp-page="./Index" class="btn btn-secondary">← Назад</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}